# Default deny: only source files needed by Dockerfile enter the build context.
**
!Dockerfile
!.dockerignore
!apps/
!apps/api/
!apps/api/requirements.lock
!apps/api/app/
!apps/api/app/**
!apps/web/
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/next.config.mjs
!apps/web/next-env.d.ts
!apps/web/tsconfig.json
!apps/web/postcss.config.mjs
!apps/web/tailwind.config.ts
!apps/web/app/
!apps/web/app/**
!apps/web/components/
!apps/web/components/**
!apps/web/lib/
!apps/web/lib/**
!apps/web/public/
!apps/web/public/**
!scripts/
!scripts/container.py
!content/
!content/cooked-examples.md
!content/demo-extra.json
!content/demo-catalog.json
!content/demo-cook-fixtures.json
!content/iran-catalog.json
!content/dramma-legacy-checksums.json
!DRAMMA_450_activities_fa.json
# These exclusions also apply inside allowed source directories.
**/.env
**/.env.*
**/__pycache__
**/*.py[cod]
**/*.log
**/*.pem
**/*.key
!content/activities.json

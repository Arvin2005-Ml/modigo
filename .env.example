# Copy to .env; server-only. Process environment overrides the file.
DATA_BACKEND=mongo
# Use the public endpoint for localhost too. Fill the password outside version control.
MONGODB_URI=mongodb://root:YOUR_PASSWORD@olympus.liara.cloud:34468/my-app?authSource=admin
# Generate once: python -c 'import secrets; print(secrets.token_hex(32))'
CSRF_HMAC_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_WORKERS=1
JOB_RUNNER_MODE=in_process
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
# Extra browser origins accepted for CSRF/CORS, comma-separated canonical HTTPS origins.
CSRF_TRUSTED_ORIGINS=https://moodigo.ir,https://www.moodigo.ir
DEMO_CONTENT=true
# real700 is the owner-authorized authored catalog; legacy is for old fixtures.
CATALOG_RELEASE=real700
LLM_PROVIDER=demo
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gapgpt-deepseek-v4.1-flash
GAPGPT_API_KEY=
